{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec \"ts-node --files\" src/local.ts",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.6",
    "dodopayments": "^2.42.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "mongodb": "^7.3.0",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "eslint": "^9.39.5",
    "firebase-functions-test": "^3.4.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.1"
  },
  "private": true
}
